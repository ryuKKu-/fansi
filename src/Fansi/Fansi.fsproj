<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fansi</RootNamespace>
    <PackageId>Fansi.Tui</PackageId>
    <Version>0.0.0</Version> <!-- x-release-please-version -->
    <Authors>Luc Raymond</Authors>
    <Description>Terminal user interfaces in F#, with the Elm architecture.</Description>
    <PackageTags>tui terminal console elmish fsharp</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ryuKKu-/fansi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- Paket's pack task cannot build a .snupkg, so the PDB travels inside the DLL. Debuggers and SourceLink still find it. -->
    <DebugType>embedded</DebugType>
    <!-- GitHub Actions sets CI=true. Local builds keep full paths for debugging. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fansi.Tests" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Core\Geometry.fs" />
    <Compile Include="Core\Style.fs" />
    <Compile Include="Core\Props.fs" />
    <Compile Include="Core\Node.fs" />
    <Compile Include="Text\Width.fs" />
    <Compile Include="Text\Runs.fs" />
    <Compile Include="Ui.fs" />
    <Compile Include="Layout\Solver.fs" />
    <Compile Include="Layout\Layout.fs" />
    <Compile Include="Rendering\Buffer.fs" />
    <Compile Include="Rendering\Renderer.fs" />
    <Compile Include="Terminal\Events.fs" />
    <Compile Include="Terminal\InputParser.fs" />
    <Compile Include="Terminal\Terminal.fs" />
    <Compile Include="Program\Types.fs" />
    <Compile Include="Program\Elmish.fs" />
    <Compile Include="Program\Keymap.fs" />
    <Compile Include="Program\Focus.fs" />
    <Compile Include="Program\Cursor.fs" />
    <Compile Include="Program\FansiProgram.fs" />
    <Compile Include="Components\Timer.fs" />
    <Compile Include="Components\TextInput.fs" />
    <Compile Include="Components\Button.fs" />
    <Compile Include="Components\List.fs" />
    <Compile Include="Components\Checkbox.fs" />
    <Compile Include="Components\ProgressBar.fs" />
    <Compile Include="Components\Spinner.fs" />
    <Compile Include="Components\Viewport.fs" />
    <Compile Include="Components\Help.fs" />
    <None Include="paket.references" />
  </ItemGroup>
  <Import Project="..\..\.paket\Paket.Restore.targets" />
</Project>
