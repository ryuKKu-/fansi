source https://api.nuget.org/v3/index.json
storage: none
framework: auto-detect

nuget FSharp.Core >= 8.0.400 lowest_matching: true
nuget elmish

group tests
    source https://api.nuget.org/v3/index.json
    storage: none
    framework: auto-detect

    nuget xunit
    nuget xunit.runner.visualstudio
    nuget Microsoft.NET.Test.Sdk
    nuget FsCheck.Xunit
